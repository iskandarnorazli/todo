{
  "name": "todo",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check:docs": "node scripts/check-docs.mjs && node scripts/check-skill-mirror.mjs",
    "bundle": "expo export --platform android --output-dir dist",
    "ci": "npm run lint && npm run typecheck && npm run check:docs && npm test -- --ci && npm run bundle"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "*",
    "expo": "*",
    "expo-status-bar": "*",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/react": "*",
    "eslint": "^9.30.0",
    "eslint-config-expo": "*",
    "jest": "~29.7.0",
    "jest-expo": "*",
    "typescript": "*"
  }
}
