{
  "name": "todo",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check:docs": "node scripts/check-docs.mjs && node scripts/check-skill-mirror.mjs",
    "bundle": "expo export --platform android --output-dir dist",
    "ci": "npm run lint && npm run typecheck && npm run check:docs && npm test -- --ci && npm run bundle"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "~0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.30.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  }
}
